# Copy this file to .env and populate only local secrets. The real .env file
# is ignored by Git and must never be committed.
OPENAI_API_KEY=

# Optional localhost application settings. Frozen model names, revisions,
# retrieval parameters, and generation limits cannot be overridden here.
TEXTBOOK_CHAT_DATA_DIR=app_data
TEXTBOOK_CHAT_PORT=8765
TEXTBOOK_CHAT_MAX_UPLOAD_MB=500
TEXTBOOK_CHAT_MAX_PDF_PAGES=1500
